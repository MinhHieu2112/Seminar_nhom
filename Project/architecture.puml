@startuml System_Architecture_Actual

' Config themes & styles for a premium look
skinparam roundcorner 10
skinparam shadowing false
skinparam Handwritten false
skinparam packageStyle rectangle

' Define clean and high-contrast color scheme
!define COLOR_CLIENT #E3F2FD
!define COLOR_GATEWAY #E8F5E9
!define COLOR_SERVICE #FFFDE7
!define COLOR_INFRA #ECEFF1
!define COLOR_EXTERNAL #F3E5F5

skinparam Package {
    BackgroundColor #FAFAFA
    BorderColor #B0BEC5
    FontColor #37474F
    FontStyle bold
}

skinparam Rectangle {
    BackgroundColor COLOR_SERVICE
    BorderColor #FBC02D
    FontColor #212121
}

skinparam Database {
    BackgroundColor COLOR_INFRA
    BorderColor #607D8B
    FontColor #212121
}

skinparam Cloud {
    BackgroundColor COLOR_EXTERNAL
    BorderColor #9C27B0
    FontColor #212121
}

title Sơ đồ Kiến trúc Hệ thống Thực tế (Actual System Architecture)

' ==========================================
' 1. CLIENT SIDE LAYER
' ==========================================
package "Client Side (Port 3000)" as client_layer {
    rectangle "Browser / Mobile App\n(Next.js Frontend)" as client COLOR_CLIENT
}

' ==========================================
' 2. API GATEWAY LAYER
' ==========================================
package "API Gateway Layer (Port 8000)" as gateway_layer {
    rectangle "API Gateway (NestJS)\n- Định tuyến request\n- Tích hợp Passport OAuth\n- Quản lý Upload File (Cloudinary)" as gateway COLOR_GATEWAY
}

' ==========================================
' 3. MICROSERVICES LAYER
' ==========================================
package "Microservices Layer" as microservices_layer {
    
    package "User Service\n(TCP 8001 / HTTP 8011)" as user_service_pkg {
        rectangle "User Service Core\n- Đăng ký & Đăng nhập\n- Quản lý User Profile\n- Xác thực OTP" as user_service
    }
    
    package "Scheduler Service\n(TCP 8004 / HTTP 8003)" as scheduler_service_pkg {
        rectangle "Scheduler Service Core\n- Quản lý Mục tiêu (Goals)\n- Quản lý Lịch học (Schedules)\n- Giao việc cá nhân (Tasks)" as scheduler_service
        rectangle "Analytics Submodule\n- Thống kê & Phân tích\n- Đề xuất Insights học tập" as analytics_sub
        rectangle "Notification Submodule\n- Nhắc nhở lịch học sắp tới" as notification_sub
        rectangle "Analytics WS Gateway\n(Real-time Updates)" as ws_analytics COLOR_CLIENT
        
        scheduler_service -[hidden]down- analytics_sub
        analytics_sub -[hidden]right- notification_sub
        analytics_sub -[hidden]down- ws_analytics
    }
    
    package "Teamwork Service\n(TCP 8007 / HTTP 8006)" as teamwork_service_pkg {
        rectangle "Teamwork Service Core\n- Quản lý Nhóm học tập\n- Mời thành viên mới\n- Giao việc & Duyệt bài" as teamwork_service
        rectangle "Message Submodule\n- Kênh chat nội bộ\n- Lưu lịch sử tin nhắn" as message_sub
        rectangle "Notification Submodule\n- Thông báo thay đổi trong nhóm" as teamwork_notification_sub
        rectangle "Message WS Gateway\n(Real-time Chat)" as ws_chat COLOR_CLIENT
        
        teamwork_service -[hidden]down- message_sub
        message_sub -[hidden]right- teamwork_notification_sub
        message_sub -[hidden]down- ws_chat
    }
    
    package "AI Service\n(TCP 8005)" as ai_service_pkg {
        rectangle "AI Service Core\n- Chuẩn hóa dữ liệu đầu vào\n- Phân tích Prompt tiếng Việt\n- Đọc & Trích xuất File/Ảnh\n- Tự động lên lịch tối ưu" as ai_service
    }
}

' ==========================================
' 4. SHARED INFRASTRUCTURE LAYER
' ==========================================
package "Shared Infrastructure" as infra_layer {
    database "PostgreSQL (Port 5432)" as postgres {
        folder "db_user\n(User database)" as db_user
        folder "db_scheduler\n(Scheduler database)" as db_scheduler
        folder "db_teamwork\n(Teamwork database)" as db_teamwork
    }
    
    database "Redis Cache (Port 6379)\n(Session, OTP Cache & NestJS Transport Broker)" as redis
}

' ==========================================
' 5. EXTERNAL SERVICES LAYER
' ==========================================
package "External Services & APIs" as external_layer {
    cloud "Third-Party OAuth\n(Google, Discord, GitHub, LinkedIn)" as oauth
    cloud "Cloudinary\n(Avatar & Attachment CDN)" as cloudinary
    cloud "AI Providers\n(Google Gemini & OpenAI APIs)" as ai_apis
    cloud "Giphy API\n(Trending Stickers & GIFs)" as giphy
}

' ==========================================
' CONNECTIONS & PROTOCOLS
' ==========================================

' --- Client Connections ---
client ===> gateway : "HTTP / REST\n(API Calls)"
client ...> ws_analytics : "WebSockets\n(Real-time Analytics)"
client ...> ws_chat : "WebSockets\n(Real-time Chat)"

' --- Gateway to Microservices (TCP RPC & HTTP Hybrid) ---
gateway ==[#blue]=> user_service : "TCP (Port 8001)\n(RPC: user.login, user.register,...)"

gateway ==[#blue]=> scheduler_service : "TCP (Port 8004)\n(RPC: analytics.dashboard.get,...)"
gateway ---> scheduler_service : "HTTP / REST (Port 8003)\n(CRUD: Goal, Task, Schedule)"

gateway ---> teamwork_service : "HTTP / REST (Port 8006)\n(CRUD: Group, Member, Messages)"

gateway ==[#blue]=> ai_service : "TCP (Port 8005)\n(RPC: ai.generate-schedule,...)"

' --- Microservices to Microservices ---
scheduler_service ---> user_service : "HTTP (Port 8011)\n(Fetch User Context)"
teamwork_service ---> user_service : "HTTP (Port 8011)\n(Fetch Member Context)"

' --- Database Connections (Prisma ORM) ---
user_service ---> db_user : "SQL connection"
scheduler_service ---> db_scheduler : "SQL connection"
teamwork_service ---> db_teamwork : "SQL connection"

' --- Redis Caching & Microservice Transports ---
user_service ---> redis : "Caching & Session storage"
scheduler_service ---> redis : "Transport.REDIS (Port 6379)"
teamwork_service ---> redis : "Transport.REDIS (Port 6379)"

' --- External API Connections ---
gateway ---> oauth : "OAuth Flow"
gateway ---> cloudinary : "Upload Media"
ai_service ===> ai_apis : "Generative AI Queries"
teamwork_service ===> giphy : "GIFs / Stickers search"

' ==========================================
' DIAGRAM LEGEND
' ==========================================
legend right
|= Đường kết nối |= Ý nghĩa |
|<#blue>==>| Giao tiếp TCP RPC nội bộ giữa Gateway & Microservices |
|===>| Giao tiếp HTTP / REST (Client -> Gateway hoặc Gateway -> External) |
|...>| Giao tiếp WebSockets (WS/WSS) thời gian thực |
|--->| Truy vấn Database SQL, Lưu Cache hoặc Tích hợp API dịch vụ ngoài |
endlegend

@enduml
