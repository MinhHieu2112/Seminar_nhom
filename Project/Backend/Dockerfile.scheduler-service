# Multi-stage build for scheduler-service (TCP + HTTP Microservice)
FROM node:20-alpine AS builder

WORKDIR /app

RUN apk add --no-cache tzdata

# Copy package files and install ALL deps (including dev)
COPY package*.json ./
RUN npm ci

# Copy source and generate Prisma client, then build
COPY . .
RUN npx prisma generate --schema=src/scheduler-service/prisma/schema.prisma
RUN npm run build

# ── Production stage ──────────────────────────────────────────
FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache tzdata
ENV TZ=Asia/Ho_Chi_Minh

# Install production deps only
COPY package*.json ./
RUN npm ci --only=production && npm cache clean --force

# Copy compiled output from builder
COPY --from=builder /app/dist ./dist

# Copy generated Prisma client (not shipped in node_modules by npm ci --only=production)
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma/client ./node_modules/@prisma/client

EXPOSE 8003

CMD ["node", "dist/main.scheduler.js"]
