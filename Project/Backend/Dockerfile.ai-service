# Multi-stage build for AI Service (TCP Microservice)
FROM node:20-alpine AS builder

# Install pnpm
RUN npm install -g pnpm

WORKDIR /app

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
# Fix: Ensure Prisma types are available for the global Nest build
RUN pnpm prisma generate --schema=src/scheduler-service/scheduler/prisma/schema.prisma
RUN pnpm run build

# Production stage
FROM node:20-alpine

# Install pnpm
RUN npm install -g pnpm

WORKDIR /app

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --prod --frozen-lockfile && pnpm store prune

COPY --from=builder /app/dist ./dist

EXPOSE 8005

# Entry point: main.ai.js (compiled from src/main.ai.ts)
CMD ["node", "dist/main.ai.js"]
