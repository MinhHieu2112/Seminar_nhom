# Backend Environment Variables
# Copy this file to .env

NODE_ENV=development

# API Gateway (HTTP)
GATEWAY_PORT=8000
FRONTEND_URL=http://localhost:3000

# JWT Secrets (Must be at least 32 characters long!)
JWT_SECRET=your_32_characters_long_secure_jwt_secret_key
JWT_REFRESH_SECRET=your_32_characters_long_secure_refresh_jwt_secret_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Internal Service shared secret (Must be at least 32 characters long!)
INTERNAL_SERVICE_SECRET=your_32_characters_long_internal_service_secret

# Microservices (TCP)
USER_SERVICE_HOST=127.0.0.1
USER_SERVICE_PORT=8001
SCHEDULER_SERVICE_HOST=127.0.0.1
SCHEDULER_SERVICE_PORT=8003
NOTIFICATION_SERVICE_HOST=127.0.0.1
NOTIFICATION_SERVICE_PORT=8002
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8005


ANALYTICS_SERVICE_HOST=127.0.0.1
ANALYTICS_SERVICE_PORT=8006

# Database (PostgreSQL)
DATABASE_URL=postgresql://studyplan:secret@localhost:5432/studyplan
SCHEDULER_DATABASE_URL=postgresql://studyplan:secret@localhost:5432/db_scheduler

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@studyplan.app

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:8000/api/v1/auth/discord/callback

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:8000/api/v1/auth/linkedin/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Scheduler HTTP endpoint (local dev)
SCHEDULER_SERVICE_URL=http://localhost:8003

# ==========================================
# Giphy Sticker SDK Configuration
# ==========================================
GIPHY_API_KEY=

# ==========================================
# Distributed Rate Limiting Configuration (seconds, v6+)
# ==========================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ==========================================
# AI Services API Keys
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

