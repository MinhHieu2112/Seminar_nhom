# Backend Environment Variables
# Copy this file to .env

NODE_ENV=development

# API Gateway (HTTP)
GATEWAY_PORT=8000
FRONTEND_URL=http://localhost:3000

# JWT Secrets (change in production!)
JWT_SECRET=dev_jwt_secret_change_in_production
REFRESH_TOKEN_SECRET=dev_refresh_secret_change_in_production

# Microservices (TCP)
USER_SERVICE_HOST=127.0.0.1
USER_SERVICE_PORT=8001
SCHEDULER_SERVICE_HOST=127.0.0.1
SCHEDULER_SERVICE_PORT=8003
NOTIFICATION_SERVICE_HOST=127.0.0.1
NOTIFICATION_SERVICE_PORT=8002
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8005


ANALYTICS_SERVICE_HOST=127.0.0.1
ANALYTICS_SERVICE_PORT=8006

# Database (PostgreSQL)
DATABASE_URL=postgresql://studyplan:secret@localhost:5432/studyplan

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@studyplan.app

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:8000/api/v1/auth/facebook/callback

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:8000/api/v1/auth/linkedin/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Scheduler HTTP endpoint (local dev)
SCHEDULER_SERVICE_URL=http://localhost:8003
