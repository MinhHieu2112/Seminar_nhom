@startuml
skinparam backgroundColor #FFFFFF
skinparam activity {
  BackgroundColor #F8F9FA
  BorderColor #343A40
  FontColor #212529
  ArrowColor #495057
}

title AI Development & Testing Pipeline

start

:Ý tưởng chức năng;
:Gemini phân tích logic\n(nghiệp vụ, luồng xử lý);
:ChatGPT xây dựng Prompt\ntheo phương pháp Five S;
:Prompt theo từng chức năng/module;
:Antigravity sinh mã nguồn;

repeat :Kiểm tra kết quả;
  if (Thành công?) then (Có)
    :Chuyển sang kiểm thử;
    break
  else (Phát sinh lỗi)
    :Antigravity sửa lỗi;
    if (Sau 2 lần chưa xử lý được?) then (Đúng)
      :Chuyển sang Codex\nphân tích và sửa lỗi;
      :Hoàn thiện mã nguồn;
      break
    else (Tiếp tục sửa)
    endif
  endif
repeat while (Cần kiểm tra lại)

:AI sinh test case kiểm thử;
:Thực hiện Unit/Integration Test;

repeat :Đánh giá kết quả test;
  if (Pass Test?) then (Có)
    :Hoàn thiện hệ thống;
    stop
  else (Fail Test)
    :Quay lại sửa lỗi;
  endif
backward :Sửa lỗi mã nguồn;
repeat while (Chưa vượt qua test)

@enduml
