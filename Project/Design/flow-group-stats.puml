@startuml Group Stats Flow

skinparam {
    BackgroundColor #FAFAFA
    ArrowColor #555555
    ArrowThickness 1.5
    defaultFontName Arial
    defaultFontSize 12
    shadowing false
    Padding 5
    Margin 3
    SequenceArrowThickness 1.5
    SequenceBoxBorderColor #AAAAAA
    SequenceBoxBackgroundColor #F9F9F9
    SequenceLifeLineBorderColor #888888
    SequenceLifeLineBackgroundColor #FFFFFF
    ParticipantBorderColor #888888
    ParticipantBackgroundColor #FFFFFF
    ActorBorderColor #555555
    NoteBackgroundColor #FFFFF0
    NoteBorderColor #CCCCCC
}

title Luồng Thống Kê Theo Nhóm (Group Statistics)

actor "Người dùng" as User
participant "GroupDetailsPage\n[id]/page.tsx" as Page
participant "StatsTab\n(component)" as Stats
participant "useGetGroupDetails\n(hook)" as GroupHook
participant "useSchedulerTasks\n(hook)" as TaskHook
participant "useUsersProfiles\n(hook)" as ProfileHook
participant "schedulerService\n/ groupService" as Service
participant "API Gateway\n:8000" as Gateway
participant "Teamwork Service\n:8003" as TWBackend
participant "Users Service\n:8001" as UserBackend
database "PostgreSQL\ndb_teamwork" as TWDB
database "PostgreSQL\ndb_user" as UserDB

== 1. Tải dữ liệu nhóm ==

User -> Page : Truy cập /scheduler/teamwork/[id]
activate Page

Page -> GroupHook : useGetGroupDetails(id)
activate GroupHook
GroupHook -> Service : groupService.getGroupDetails(id)
Service -> Gateway : GET /api/v1/teamwork/groups/{id}\n[Bearer token]
activate Gateway
Gateway -> TWBackend : forward
activate TWBackend
TWBackend -> TWDB : SELECT group, members\nWHERE id = ?
activate TWDB
TWDB --> TWBackend : { group, members[] }
deactivate TWDB
TWBackend --> Gateway : group data
deactivate TWBackend
Gateway --> Service : group data
deactivate Gateway
Service --> GroupHook : { id, name, members[], createdAt }
GroupHook --> Page : group
deactivate GroupHook

== 2. Tải danh sách task của nhóm ==

Page -> TaskHook : useSchedulerTasks(groupId)
activate TaskHook
TaskHook -> Service : schedulerService.getTasks({ groupId })
Service -> Gateway : GET /api/v1/teamwork/groups/{id}/tasks
activate Gateway
Gateway -> TWBackend : forward
activate TWBackend
TWBackend -> TWDB : SELECT groupTasks\nWHERE groupId = ?
activate TWDB
TWDB --> TWBackend : tasks[]
deactivate TWDB
TWBackend --> Gateway : tasks[]
deactivate TWBackend
Gateway --> Service : tasks[]
deactivate Gateway
Service --> TaskHook : tasks[]
TaskHook --> Page : groupTasks[]
deactivate TaskHook

== 3. Tải profile thành viên ==

Page -> ProfileHook : useUsersProfiles(memberIds[])
activate ProfileHook
ProfileHook -> Service : GET /api/v1/users/many\n?ids=[...]
Service -> Gateway : batch profile request
activate Gateway
Gateway -> UserBackend : forward
activate UserBackend
UserBackend -> UserDB : SELECT users\nWHERE id IN (...)
activate UserDB
UserDB --> UserBackend : profiles[]
deactivate UserDB
UserBackend --> Gateway : profiles[]
deactivate UserBackend
Gateway --> Service : profiles[]
deactivate Gateway
Service --> ProfileHook : profiles[]
ProfileHook --> Page : profiles[]
deactivate ProfileHook

== 4. Người dùng mở tab Thống kê ==

User -> Page : Click tab "Thống kê"
Page -> Page : setActiveTab('stats')
Page -> Stats : <StatsTab group tasks profiles />
activate Stats

== 5. Tính toán biểu đồ tròn (Trạng thái công việc) ==

Stats -> Stats : useMemo() → statusData[]
note over Stats
  **Phân loại task:**
  done → "Xong" (#10B981)
  submittedForReview → "Chờ duyệt" (#3B82F6)
  dueTime < now → "Trễ hạn" (#EF4444)
  còn lại → "Chờ" (#F59E0B)
  Lọc bỏ giá trị = 0
end note
Stats -> Stats : Render PieChart\ninnerRadius=70, outerRadius=100\nlabel: "Tên X%"

== 6. Tính toán biểu đồ cột (Đóng góp thành viên) ==

Stats -> Stats : useMemo() → memberData[]
note over Stats
  **Với mỗi thành viên:**
  1. Khởi tạo counts[userId] = { total:0, done:0 }
  2. Duyệt tasks → đếm theo assigneeId
  3. Map userId → firstName + lastName (từ profiles)
  4. Sort giảm dần theo "Tổng task"
end note
Stats -> Stats : Render BarChart (layout=vertical)\nBar "Tổng task" (#cbd5e1)\nBar "Đã hoàn thành" (#6366f1)

Stats --> Page : Hiển thị 2 biểu đồ
deactivate Stats

Page --> User : Render StatsTab đầy đủ

== 7. Cập nhật khi task thay đổi ==

note over Page, TWBackend
  **Khi Admin thực hiện hành động:**
  - Duyệt task (approveTask) → status = 'done'
  - Từ chối task (rejectTask) → status = 'pending'
  - Tạo/xóa/cập nhật task
end note

User -> Page : Admin duyệt / từ chối task
Page -> Service : PATCH /api/v1/teamwork/tasks/{id}/approve\nhoặc /reject
Service -> Gateway : request
Gateway -> TWBackend : forward
TWBackend -> TWDB : UPDATE groupTask\nSET status = 'done'/'pending'
TWDB --> TWBackend : updated task
TWBackend --> Gateway : task mới
Gateway --> Service : task mới
Service --> Page : mutation onSuccess()
Page -> TaskHook : queryClient.invalidateQueries()\n[SCHEDULER_QUERY_KEY, 'tasks']
TaskHook -> Service : Refetch groupTasks
Service --> TaskHook : tasks[] cập nhật
TaskHook --> Page : groupTasks[] mới
Page -> Stats : Re-render với dữ liệu mới
Stats -> Stats : Tính lại statusData[]\nvà memberData[]
Stats --> User : Biểu đồ cập nhật tức thì

deactivate Page

@enduml
