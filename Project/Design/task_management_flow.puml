@startuml task_management_flow
title Luồng Quản lý tác vụ Cá nhân

start
:Người dùng mở Dashboard;
:Chọn "Thêm tác vụ mới";
if (Nhập thông tin tác vụ?) then (Hợp lệ)
    :Hệ thống lưu tác vụ vào DB;
    :Hiển thị tác vụ trên lịch trình;
    while (Đến hạn?) is (Chưa)
        :Người dùng cập nhật trạng thái;
        :Hệ thống ghi nhận tiến độ;
    endwhile (Hoàn thành)
    :Đánh dấu tác vụ là "Xong";
else (Thiếu thông tin)
    :Hiển thị thông báo lỗi;
    stop
endif
stop
@enduml
