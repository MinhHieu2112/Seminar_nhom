@startuml
skinparam monochrome true
actor "Leader" as Leader
actor "Member" as Member
participant "Frontend" as FE
participant "Teamwork Service" as TS
participant "Notification Service" as NS
database "Teamwork DB" as DB

Leader -> FE : Giao Task cho Member
FE -> TS : POST /groups/:id/tasks
TS -> DB : Lưu GroupTask
TS -> NS : Gửi Notify cho Member
NS --> Member : Thông báo: "Bạn có task mới"

... Member làm việc ...

Member -> FE : Tải lên file minh chứng
FE -> TS : POST /tasks/:id/upload
TS -> DB : Cập nhật Task status & Attachments
TS -> NS : Gửi Notify cho Leader
NS --> Leader : Thông báo: "Member đã nộp bài"

Leader -> FE : Xem & Phê duyệt
FE -> TS : PATCH /tasks/:id/approve
TS -> DB : Update status = 'Approved'
TS --> FE : Thành công
@enduml
