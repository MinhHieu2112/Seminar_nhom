@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Arial"

title Quy trình phát triển phần mềm hỗ trợ bởi AI

start
:Ý tưởng (Idea);
note right: Xác định yêu cầu tính năng

:Tạo Context (Context Creation);
note right: Thu thập tài liệu, mã nguồn liên quan

repeat
    :Prompting;
    note right: Gửi yêu cầu chi tiết cho AI

    :AI Sinh code (AI Code Generation);
    
    repeat
        :Human Review;
        note right: Kiểm tra logic và coding convention
        if (Cần chỉnh sửa?) then (Có)
            :Developer sửa lỗi/Tối ưu;
        endif
    backward: Tiếp tục Review;
    repeat while (Cần chỉnh sửa?) is (Có)

    :Testing;
    note right: Unit Test / Integration Test
backward: Quay lại sửa lỗi;
repeat while (Test Fail?) is (Có)

:Hoàn thiện & Triển khai;
stop
@enduml
